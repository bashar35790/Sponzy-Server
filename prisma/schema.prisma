generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  CREATOR
  ADMIN
}

enum Status {
  ACTIVE
  SUSPENDED
  PENDING
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ZIP
}

enum PostLock {
  FREE
  SUBSCRIBERS_ONLY
  PAY_PER_VIEW
}

enum TransactionType {
  SUBSCRIPTION
  TIP
  PPV
  PRODUCT_PURCHASE
  DEPOSIT
  WITHDRAWAL
  LIVE_STREAM
  CALL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------------------------------
// USER & PROFILE
// ----------------------------------------------------
model User {
  id                    String              @id @default(uuid())
  supabaseId            String?             @unique
  name                  String
  username              String              @unique
  email                 String              @unique
  password              String?
  role                  Role                @default(USER)
  status                Status              @default(ACTIVE)
  avatar                String?             @default("/default-avatar.png")
  cover                 String?             @default("/default-cover.png")
  bio                   String?
  profession            String?
  website               String?
  countryId             String?
  country               Country?            @relation(fields: [countryId], references: [id])
  isVerified            Boolean             @default(false)
  isFeatured            Boolean             @default(false)
  hideProfile           Boolean             @default(false)
  hideLastSeen          Boolean             @default(false)
  hideSubscribersCount  Boolean             @default(false)
  darkMode              Boolean             @default(true)
  walletBalance         Decimal             @default(0.00) @db.Decimal(12, 2)
  creatorMonthlyPrice   Decimal             @default(0.00) @db.Decimal(10, 2)
  freeSubscription      Boolean             @default(false)
  stripeCustomerId      String?
  stripeConnectId       String?
  paypalEmail           String?
  twoFactorEnabled      Boolean             @default(false)
  twoFactorSecret       String?
  lastSeen              DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  posts                 Post[]
  postLikes             PostLike[]
  postComments          PostComment[]
  bookmarks             Bookmark[]
  stories               Story[]
  storyViews            StoryView[]
  reels                 Reel[]
  reelLikes             ReelLike[]
  reelComments          ReelComment[]
  plans                 Plan[]
  sentMessages          Message[]           @relation("SentMessages")
  receivedMessages      Message[]           @relation("ReceivedMessages")
  conversationsAsUser1  Conversation[]      @relation("UserOne")
  conversationsAsUser2  Conversation[]      @relation("UserTwo")
  subscriptionsGiven    Subscription[]      @relation("Subscriber")
  subscriptionsReceived Subscription[]      @relation("Creator")
  transactions          Transaction[]
  products              Product[]
  purchases             Purchase[]
  liveStreams           LiveStreaming[]
  liveComments          LiveComment[]
  liveLikes             LiveLike[]
  audioCallsInitiated   AudioCall[]         @relation("AudioCaller")
  audioCallsReceived    AudioCall[]         @relation("AudioReceiver")
  videoCallsInitiated   VideoCall[]         @relation("VideoCaller")
  videoCallsReceived    VideoCall[]         @relation("VideoReceiver")
  notifications         Notification[]      @relation("Recipient")
  notificationsTriggered Notification[]     @relation("Actor")
  verificationRequests  VerificationRequest[]
  vaultItems            VaultItem[]

  @@index([username])
  @@index([email])
}

// ----------------------------------------------------
// POSTS & MEDIA
// ----------------------------------------------------
model Post {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  description     String?
  lockType        PostLock       @default(FREE)
  price           Decimal        @default(0.00) @db.Decimal(10, 2)
  isPinned        Boolean        @default(false)
  status          Status         @default(ACTIVE)
  scheduledFor    DateTime?
  viewsCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  media           PostMedia[]
  likes           PostLike[]
  comments        PostComment[]
  bookmarks       Bookmark[]
  postViews       PostView[]
  purchases       Purchase[]

  @@index([userId])
  @@index([createdAt])
}

model PostMedia {
  id              String         @id @default(uuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  type            MediaType      @default(IMAGE)
  url             String
  thumbnailUrl    String?
  blurhash        String?
  fileSize        Int?
  duration        Int?
  width           Int?
  height          Int?
  createdAt       DateTime       @default(now())

  @@index([postId])
}

model PostLike {
  id              String         @id @default(uuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id              String         @id @default(uuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([postId])
}

model Bookmark {
  id              String         @id @default(uuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@unique([postId, userId])
}

model PostView {
  id              String         @id @default(uuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  ipAddress       String?
  createdAt       DateTime       @default(now())

  @@index([postId])
}

// ----------------------------------------------------
// STORIES & REELS
// ----------------------------------------------------
model Story {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl        String
  type            MediaType      @default(IMAGE)
  caption         String?
  backgroundColor String?
  fontFamily      String?
  expiresAt       DateTime
  createdAt       DateTime       @default(now())

  views           StoryView[]

  @@index([userId])
  @@index([expiresAt])
}

model StoryView {
  id              String         @id @default(uuid())
  storyId         String
  story           Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@unique([storyId, userId])
}

model Reel {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoUrl        String
  thumbnailUrl    String?
  caption         String?
  audioTrack      String?
  viewsCount      Int            @default(0)
  createdAt       DateTime       @default(now())

  likes           ReelLike[]
  comments        ReelComment[]

  @@index([userId])
}

model ReelLike {
  id              String         @id @default(uuid())
  reelId          String
  reel            Reel           @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@unique([reelId, userId])
}

model ReelComment {
  id              String         @id @default(uuid())
  reelId          String
  reel            Reel           @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment         String
  createdAt       DateTime       @default(now())

  @@index([reelId])
}

// ----------------------------------------------------
// DIRECT MESSAGES & CHAT
// ----------------------------------------------------
model Conversation {
  id              String         @id @default(uuid())
  user1Id         String
  user1           User           @relation("UserOne", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id         String
  user2           User           @relation("UserTwo", fields: [user2Id], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime       @default(now())
  createdAt       DateTime       @default(now())

  messages        Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id              String         @id @default(uuid())
  conversationId  String
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User           @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body            String?
  isRead          Boolean        @default(false)
  price           Decimal        @default(0.00) @db.Decimal(10, 2)
  isPaid          Boolean        @default(false)
  tipAmount       Decimal        @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())

  media           MessageMedia[]
  purchases       Purchase[]

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

model MessageMedia {
  id              String         @id @default(uuid())
  messageId       String
  message         Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type            MediaType      @default(IMAGE)
  url             String
  thumbnailUrl    String?
  createdAt       DateTime       @default(now())

  @@index([messageId])
}

// ----------------------------------------------------
// SUBSCRIPTIONS & MONETIZATION
// ----------------------------------------------------
model Plan {
  id              String         @id @default(uuid())
  creatorId       String
  creator         User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name            String
  interval        String         @default("month") // month, 3months, 6months, year
  price           Decimal        @db.Decimal(10, 2)
  description     String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  subscriptions   Subscription[]

  @@index([creatorId])
}

model Subscription {
  id              String         @id @default(uuid())
  subscriberId    String
  subscriber      User           @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         User           @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id])
  stripeSubId     String?
  status          Status         @default(ACTIVE)
  endsAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([subscriberId])
  @@index([creatorId])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TransactionType
  status          PaymentStatus   @default(COMPLETED)
  amount          Decimal         @db.Decimal(10, 2)
  earningNet      Decimal         @default(0.00) @db.Decimal(10, 2)
  platformFee     Decimal         @default(0.00) @db.Decimal(10, 2)
  paymentGateway  String          @default("stripe")
  txnId           String?
  createdAt       DateTime        @default(now())

  @@index([userId])
}

// ----------------------------------------------------
// PRODUCTS & DIGITAL SHOP
// ----------------------------------------------------
model Product {
  id              String         @id @default(uuid())
  creatorId       String
  creator         User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  isPhysical      Boolean        @default(false)
  fileUrl         String?
  previewUrl      String?
  salesCount      Int            @default(0)
  status          Status         @default(ACTIVE)
  createdAt       DateTime       @default(now())

  purchases       Purchase[]

  @@index([creatorId])
}

model Purchase {
  id              String         @id @default(uuid())
  buyerId         String
  buyer           User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  postId          String?
  post            Post?          @relation(fields: [postId], references: [id])
  messageId       String?
  message         Message?       @relation(fields: [messageId], references: [id])
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  amount          Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())

  @@index([buyerId])
}

// ----------------------------------------------------
// LIVE STREAMING & CALLS
// ----------------------------------------------------
model LiveStreaming {
  id              String         @id @default(uuid())
  creatorId       String
  creator         User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  channelName     String         @unique
  agoraToken      String?
  title           String?
  isPrivate       Boolean        @default(false)
  price           Decimal        @default(0.00) @db.Decimal(10, 2)
  status          Status         @default(ACTIVE)
  endedAt         DateTime?
  createdAt       DateTime       @default(now())

  comments        LiveComment[]
  likes           LiveLike[]

  @@index([creatorId])
}

model LiveComment {
  id              String         @id @default(uuid())
  liveStreamId    String
  liveStream      LiveStreaming  @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment         String
  createdAt       DateTime       @default(now())

  @@index([liveStreamId])
}

model LiveLike {
  id              String         @id @default(uuid())
  liveStreamId    String
  liveStream      LiveStreaming  @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([liveStreamId])
}

model AudioCall {
  id              String         @id @default(uuid())
  callerId        String
  caller          User           @relation("AudioCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User           @relation("AudioReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  channelName     String
  durationSeconds Int            @default(0)
  priceTotal      Decimal        @default(0.00) @db.Decimal(10, 2)
  status          PaymentStatus  @default(COMPLETED)
  createdAt       DateTime       @default(now())

  @@index([callerId])
  @@index([receiverId])
}

model VideoCall {
  id              String         @id @default(uuid())
  callerId        String
  caller          User           @relation("VideoCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User           @relation("VideoReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  channelName     String
  durationSeconds Int            @default(0)
  priceTotal      Decimal        @default(0.00) @db.Decimal(10, 2)
  status          PaymentStatus  @default(COMPLETED)
  createdAt       DateTime       @default(now())

  @@index([callerId])
  @@index([receiverId])
}

// ----------------------------------------------------
// NOTIFICATIONS, VERIFICATION & VAULT
// ----------------------------------------------------
model Notification {
  id              String         @id @default(uuid())
  recipientId     String
  recipient       User           @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?          @relation("Actor", fields: [actorId], references: [id])
  type            String         // LIKE, COMMENT, SUBSCRIBE, TIP, PPV_PURCHASE, MESSAGE
  targetId        String?
  isRead          Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([recipientId])
}

model VerificationRequest {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String
  documentUrl     String
  selfieUrl       String
  status          VerificationStatus  @default(PENDING)
  createdAt       DateTime            @default(now())

  @@index([userId])
}

model VaultItem {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  url             String
  type            MediaType      @default(IMAGE)
  createdAt       DateTime       @default(now())

  @@index([userId])
}

model Country {
  id              String         @id @default(uuid())
  name            String
  code            String         @unique
  users           User[]
}

model AdminSettings {
  id                      String   @id @default("default")
  siteName                String   @default("Sponzy")
  siteTitle               String   @default("Creator Subscription Platform")
  siteDescription         String?
  platformFeePercentage   Decimal  @default(10.00) @db.Decimal(5, 2)
  minWithdrawalAmount     Decimal  @default(20.00) @db.Decimal(10, 2)
  watermarkEnabled        Boolean  @default(true)
  allowRegistration       Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}
